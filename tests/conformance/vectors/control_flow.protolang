// Conformance vectors for control flow (spec 15).
//
// Between them these methods use every branching and looping construct the language has:
// if / else if / else, while with a condition, while true escaped only by break, continue, and
// for-in over a repeated field. The backend smoke suites assert that the emitted source contains
// each construct; these vectors assert that it computes the same answer in both languages.

import proto "conformance.proto";

extend ControlFlowCase {
    // if / else if / else
    fn bucket() -> int64 {
        if threshold >= 100 {
            return 2;
        } else if threshold >= 10 {
            return 1;
        } else {
            return 0;
        }
    }

    // for-in, with both continue and break
    fn count_until_zero() -> int64 {
        var count: int64 = 0;

        for value in values {
            if value == 0 {
                break;
            }

            if value < threshold {
                continue;
            }

            count = count + 1;
        }

        return count;
    }

    // while with a real condition
    fn sum_first() -> int64 {
        var index: int64 = 0;
        var total: int64 = 0;

        for value in values {
            if index >= threshold {
                break;
            }

            total = total + value;
            index = index + 1;
        }

        return total;
    }

    // while true, escaped only by break
    fn countdown() -> int64 {
        var remaining: int64 = threshold;
        var steps: int64 = 0;

        while true {
            if remaining <= 0 {
                break;
            }

            remaining = remaining - 1;
            steps = steps + 1;
        }

        return steps;
    }

    // while with a condition that may run zero times
    fn doubling_steps() -> int64 {
        var value: int64 = 1;
        var steps: int64 = 0;

        while value < threshold {
            value = value + value;
            steps = steps + 1;
        }

        return steps;
    }
}

test ControlFlowCase.bucket "takes the else branch below ten" {
    receiver {
        threshold = 5;
    }

    expect return 0;
}

test ControlFlowCase.bucket "takes the else if branch at ten" {
    receiver {
        threshold = 10;
    }

    expect return 1;
}

test ControlFlowCase.bucket "takes the if branch at a hundred" {
    receiver {
        threshold = 100;
    }

    expect return 2;
}

test ControlFlowCase.count_until_zero "skips values below the threshold and stops at a zero" {
    receiver {
        threshold = 3;
        values = 5;
        values = 1;
        values = 4;
        values = 0;
        values = 9;
    }

    expect return 2;
}

test ControlFlowCase.count_until_zero "counts nothing for an empty repeated field" {
    receiver {
        threshold = 3;
    }

    expect return 0;
}

test ControlFlowCase.sum_first "sums only the leading values" {
    receiver {
        threshold = 2;
        values = 10;
        values = 20;
        values = 30;
    }

    expect return 30;
}

test ControlFlowCase.countdown "runs the loop once per step" {
    receiver {
        threshold = 4;
    }

    expect return 4;
}

test ControlFlowCase.countdown "exits immediately when there is nothing to do" {
    receiver {
        threshold = 0;
    }

    expect return 0;
}

test ControlFlowCase.doubling_steps "runs a conditional loop until it passes the threshold" {
    receiver {
        threshold = 8;
    }

    expect return 3;
}

test ControlFlowCase.doubling_steps "runs a conditional loop zero times" {
    receiver {
        threshold = 1;
    }

    expect return 0;
}
