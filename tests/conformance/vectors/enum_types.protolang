// Conformance vectors for enum type references (issue #1).
//
// The point of this vector is that the enum type can be NAMED: as a local, as a parameter, and as
// a return type. Before the binder indexed enum descriptors, only the inferred form worked, so
// none of the declarations below would compile.
//
// The behavioral coverage is deliberately thin, and not because the vector was rushed. ProtoLang
// cannot yet name an enum VALUE (there is no TopLevelStatus.LEVEL_HIGH), and test fixtures reject
// enum-typed fields, so no test can give an enum a non-default value. What these vectors do prove
// is that both backends map the enum type to the right target name -- protoc nests C# enums inside
// a Types class and flattens C++ enums with an underscore -- and that a value of that type
// round-trips through a local, an argument, and a return.

import proto "conformance.proto";

extend EnumCase {
    fn levels_match() -> bool {
        var mine: Level = level;
        var theirs: Level = other;
        return mine == theirs;
    }

    fn matches(candidate: Level) -> bool {
        return candidate == level;
    }

    fn current() -> Level {
        return level;
    }

    // Passes an enum through a call and back, so the parameter and return paths are linked
    // together rather than each being merely declared.
    fn round_trips() -> bool {
        return matches(current());
    }

    fn matches_by_qualified_name() -> bool {
        var mine: protolang.conformance.EnumCase.Level = level;
        return mine == current();
    }
}

test EnumCase.levels_match "two enum fields at their default compare equal" {
    receiver {
        count = 1;
    }

    expect return true;
}

test EnumCase.round_trips "an enum survives a round trip through an argument and a return" {
    receiver {
        count = 1;
    }

    expect return true;
}

test EnumCase.matches_by_qualified_name "an enum can be named by its fully qualified name" {
    receiver {
        count = 1;
    }

    expect return true;
}
