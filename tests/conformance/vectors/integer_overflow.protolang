// Conformance vectors for integer overflow (spec 10.1).
//
// ProtoLang integer arithmetic wraps. Neither target does that by default: C# throws when a
// consumer builds with CheckForOverflowUnderflow, and signed overflow is undefined behavior in
// C++, which optimizers are entitled to exploit. These vectors are what proves both backends
// produce the two's complement answer anyway.
//
// int64 MIN cannot be written as a literal: its magnitude does not fit in a positive 64-bit
// literal, and ProtoLang has no MIN constant. It is spelled the way <climits> spells it,
// as -MAX - 1.

import proto "conformance.proto";

extend OverflowCase {
    fn add_i32() -> int32 {
        return i32_left + i32_right;
    }

    fn sub_i32() -> int32 {
        return i32_left - i32_right;
    }

    fn mul_i32() -> int32 {
        return i32_left * i32_right;
    }

    fn negate_i32() -> int32 {
        return -i32_left;
    }

    fn add_i64() -> int64 {
        return i64_left + i64_right;
    }

    fn mul_i64() -> int64 {
        return i64_left * i64_right;
    }

    fn negate_i64() -> int64 {
        return -i64_left;
    }

    fn add_u32() -> uint32 {
        return u32_left + u32_right;
    }

    fn sub_u32() -> uint32 {
        return u32_left - u32_right;
    }

    // uint64 values above 2^63 - 1 cannot be written as literals either, so the wrapped result is
    // checked by halving it: 2^64 - 1 halved is exactly int64 MAX.
    fn halved_sub_u64() -> uint64 {
        return (u64_left - u64_right) / 2;
    }
}

test OverflowCase.add_i32 "int32 addition wraps past MAX" {
    receiver {
        i32_left = 2147483647;
        i32_right = 1;
    }

    expect return -2147483647 - 1;
}

test OverflowCase.sub_i32 "int32 subtraction wraps past MIN" {
    receiver {
        i32_left = -2147483647 - 1;
        i32_right = 1;
    }

    expect return 2147483647;
}

test OverflowCase.mul_i32 "int32 multiplication discards the high word" {
    receiver {
        i32_left = 65536;
        i32_right = 65536;
    }

    expect return 0;
}

test OverflowCase.mul_i32 "int32 multiplication wraps to a negative result" {
    receiver {
        i32_left = 2147483647;
        i32_right = 2;
    }

    expect return -2;
}

// Negating int32 MIN has no representable result, so under wrapping it is MIN again.
test OverflowCase.negate_i32 "negating int32 MIN yields MIN" {
    receiver {
        i32_left = -2147483647 - 1;
    }

    expect return -2147483647 - 1;
}

test OverflowCase.add_i64 "int64 addition wraps past MAX" {
    receiver {
        i64_left = 9223372036854775807;
        i64_right = 1;
    }

    expect return -9223372036854775807 - 1;
}

test OverflowCase.mul_i64 "int64 multiplication discards the high word" {
    receiver {
        i64_left = 4294967296;
        i64_right = 4294967296;
    }

    expect return 0;
}

test OverflowCase.negate_i64 "negating int64 MIN yields MIN" {
    receiver {
        i64_left = -9223372036854775807 - 1;
    }

    expect return -9223372036854775807 - 1;
}

test OverflowCase.add_u32 "uint32 addition wraps to zero" {
    receiver {
        u32_left = 4294967295;
        u32_right = 1;
    }

    expect return 0;
}

test OverflowCase.sub_u32 "uint32 subtraction wraps to MAX" {
    receiver {
        u32_left = 0;
        u32_right = 1;
    }

    expect return 4294967295;
}

test OverflowCase.halved_sub_u64 "uint64 subtraction wraps to MAX" {
    receiver {
        u64_left = 0;
        u64_right = 1;
    }

    expect return 9223372036854775807;
}
